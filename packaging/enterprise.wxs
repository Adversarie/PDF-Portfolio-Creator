<?xml version="1.0" encoding="UTF-8"?>
<!--
  packaging/enterprise.wxs
  WiX Toolset v3/v4 Enterprise MSI Manifest for PDF Portfolio Maker.
  Supports silent Group Policy / SCCM / Intune deployment:
    msiexec /i PDFPortfolioMaker-Enterprise-1.0.0.msi /qn LICENSE_KEY="PPM1..."
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="PDF Portfolio Maker"
    Language="1033"
    Version="1.0.0.0"
    Manufacturer="PDF Portfolio Maker Team"
    UpgradeCode="9F6D14C3-7E1A-49F1-8B0C-E62D037D71C9">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="100% Air-Gapped ISO 32000-1 (/Collection) PDF Portfolio Builder" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Public MSI Property for Zero-Touch License Key Provisioning -->
    <Property Id="LICENSE_KEY" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="PDF Portfolio Maker" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="PROGRAMDATA_APP_DIR" Name="PDFPortfolioMaker" />
      </Directory>
      <Directory Id="LocalAppDataFolder">
        <Directory Id="LOCALAPPDATA_APP_DIR" Name="PDFPortfolioMaker" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutableComponent" Guid="A14B6201-5D19-4C8E-9A11-7E4A10002001" Win64="yes">
        <File Id="PDFPortfolioMakerExe" Source="..\dist\PDFPortfolioMaker\PDFPortfolioMaker.exe" KeyPath="yes" />
        <!-- Enterprise Group Policy Registry Provisioning -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\PDFPortfolioMaker">
          <RegistryValue Type="string" Name="LicenseKey" Value="[LICENSE_KEY]" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="LOCALAPPDATA_APP_DIR">
      <Component Id="PreStagedLocalLicenseDir" Guid="B24B6201-5D19-4C8E-9A11-7E4A10002002" Win64="yes">
        <CreateFolder />
        <RemoveFolder Id="RemoveLocalAppDataAppDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PDFPortfolioMaker" Name="LocalLicenseStaged" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="PDF Portfolio Maker Enterprise" Level="1">
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="PreStagedLocalLicenseDir" />
    </Feature>
  </Product>
</Wix>
